// Esquema Prisma para entorno dev usando SQLite
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Usuarios del sistema: credenciales, rol, estado y relaciones.
model User {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  role              Role      @default(USER)
  active            Boolean   @default(true)
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  loginAttempts     Int       @default(0)
  lockedUntil       DateTime?
  lastLogin         DateTime?
  refreshToken      String?

  carts         Cart[]
  orders        PurchaseOrder[]
  addresses     Address[]
  oauthAccounts OAuthAccount[]
  userDiscounts DiscountUser[]
}

/// Cuentas OAuth vinculadas al usuario (Google, etc.).
model OAuthAccount {
  id                String    @id @default(uuid())
  provider          String
  providerAccountId String    @unique
  userId            String
  accessToken       String?
  refreshToken      String?
  tokenType         String?
  expiresAt         DateTime?
  scope             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

/// Categorías de productos con jerarquía padre/hijo.
model Category {
  id               Int                @id @default(autoincrement())
  name             String
  slug             String             @unique
  parentId         Int?
  parent           Category?          @relation("CategoryToParent", fields: [parentId], references: [id])
  children         Category[]         @relation("CategoryToParent")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  items            ItemCategory[]
  DiscountCategory DiscountCategory[]
}

// Catálogo unificado: una fila por variante con campos del producto
// Catálogo unificado: una fila por variante con campos del producto
model CatalogItem {
  id                 Int      @id @default(autoincrement())
  // Agrupador de variantes de la misma familia de producto
  familyId           String
  familySlug         String
  // Campos del producto
  productName        String
  productDescription String?
  brand              String?
  productDetails     Json?
  productAvailable   Boolean  @default(true)
  // Campos de la variante
  sku                String   @unique
  barcode            String?
  title              String?
  /// Atributos: arreglo de objetos (JSON array)
  attributes         Json?    @default(dbgenerated("'[]'::jsonb"))
  price              Float
  compareAtPrice     Float?
  currency           String?
  variantAvailable   Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relaciones
  images           Image[]
  stocks           WarehouseStock[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  discountProducts DiscountProduct[]
  categories       ItemCategory[]
}

// Relación many-to-many entre CatalogItem y Category (antes ProductCategory)
/// Relación many-to-many entre `CatalogItem` y `Category`.
model ItemCategory {
  itemId     Int
  categoryId Int
  assignedAt DateTime @default(now())

  item     CatalogItem @relation(fields: [itemId], references: [id])
  category Category    @relation(fields: [categoryId], references: [id])

  @@id([itemId, categoryId])
}

// Tabla de colores (nombre y hex)
/// Colores disponibles para variantes (nombre y código hex).
model Color {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  hex       String
  slug      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tabla de materiales (nombre)
/// Materiales disponibles para variantes.
model Material {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tabla de tipos de cierre (nombre)
/// Tipos de cierre disponibles para variantes.
model ClosureType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tabla de tamaños (size) independientes del catálogo.
model Size {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tabla de piedras (stone) independientes del catálogo.
model Stone {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Imágenes asociadas a un ítem del catálogo (variante).
model Image {
  id        Int     @id @default(autoincrement())
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  state     Boolean @default(true)
  itemId    Int

  item CatalogItem @relation(fields: [itemId], references: [id])
}

/// Carritos de compra (pueden estar asociados a un usuario).
model Cart {
  id        Int        @id @default(autoincrement())
  userId    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  user User? @relation(fields: [userId], references: [id])
}

/// Ítems dentro del carrito, referenciando una variante (`CatalogItem`).
model CartItem {
  id           Int     @id @default(autoincrement())
  quantity     Int
  cartId       Int
  itemId       Int
  isGift       Boolean @default(false)
  giftMessage  String?
  isBestSeller Boolean @default(false)
  isNew        Boolean @default(false)

  cart Cart        @relation(fields: [cartId], references: [id])
  item CatalogItem @relation(fields: [itemId], references: [id])
}

/// Almacenes y su información operativa y de capacidad.
model Warehouse {
  id                String           @id @default(uuid())
  name              String
  location          String
  address           String
  manager           String
  phone             String
  email             String
  capacity          Int
  currentOccupancy  Int
  status            WarehouseStatus  @default(ACTIVE)
  lastInventoryDate DateTime?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  stocks            WarehouseStock[]
}

/// Stock de una variante (`CatalogItem`) en un almacén.
model WarehouseStock {
  id           String          @id @default(uuid())
  itemId       Int
  warehouseId  String
  quantity     Int
  minimumStock Int
  location     String
  status       StockStatus     @default(IN_STOCK)
  lastUpdated  DateTime        @updatedAt
  price        Float?
  cost         Float?
  movements    StockMovement[]

  item      CatalogItem @relation(fields: [itemId], references: [id])
  warehouse Warehouse   @relation(fields: [warehouseId], references: [id])
}

/// Movimientos de stock (IN, OUT, TRANSFER) con referencia y notas.
model StockMovement {
  id        String       @id @default(uuid())
  stockId   String
  type      MovementType
  quantity  Int
  date      DateTime     @default(now())
  reference String?
  notes     String?
  userId    String

  stock WarehouseStock @relation(fields: [stockId], references: [id])
}

/// Descuentos: tipo, valor, fechas, estado y asignaciones.
model Discount {
  id          Int          @id @default(autoincrement())
  type        DiscountType
  value       Float
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean      @default(true)
  minQuantity Int?
  maxQuantity Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  code        String?
  usageLimit  Int?
  timesUsed   Int          @default(0)
  isGlobal    Boolean?     @default(false)

  products      DiscountProduct[]
  categories    DiscountCategory[]
  families      DiscountFamily[]
  userDiscounts DiscountUser[]
  orderItems    OrderItem[]
}

/// Asignación de descuentos a un ítem del catálogo.
model DiscountProduct {
  id         Int         @id @default(autoincrement())
  discountId Int
  itemId     Int
  discount   Discount    @relation(fields: [discountId], references: [id])
  item       CatalogItem @relation(fields: [itemId], references: [id])

  @@unique([discountId, itemId])
}

/// Asignación de descuentos a categorías.
model DiscountCategory {
  id         Int @id @default(autoincrement())
  discountId Int
  categoryId Int

  discount Discount @relation(fields: [discountId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([discountId, categoryId])
}

/// Asignación de descuentos a familias de producto (por `familySlug`).
model DiscountFamily {
  id         Int    @id @default(autoincrement())
  discountId Int
  familyId   String

  discount Discount @relation(fields: [discountId], references: [id])

  @@unique([discountId, familyId])
}

/// Asignación de descuentos a usuarios con límites de uso.
model DiscountUser {
  id         Int      @id @default(autoincrement())
  discountId Int
  userId     String
  usageLimit Int?
  timesUsed  Int      @default(0)
  assignedAt DateTime @default(now())

  discount Discount @relation(fields: [discountId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([discountId, userId])
}

/// Direcciones de usuario (facturación y envío) asociadas a órdenes.
model Address {
  id         String   @id @default(uuid())
  userId     String?
  firstName  String?
  lastName   String?
  company    String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User?           @relation(fields: [userId], references: [id])
  billingOrders  PurchaseOrder[] @relation("BillingAddress")
  shippingOrders PurchaseOrder[] @relation("ShippingAddress")
}

/// Órdenes de compra: estado, pagos, totales, direcciones y comprador.
model PurchaseOrder {
  id                   String        @id
  orderNumber          String        @unique
  status               OrderStatus   @default(PENDING)
  orderDate            DateTime      @default(now())
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  totalAmount          Float
  paymentStatus        PaymentStatus @default(PENDING)
  trackingNumber       String?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  buyerId              String
  email                String
  firstName            String
  lastName             String
  paymentMethod        String
  phone                String
  shippingAmount       Float
  subtotalAmount       Float
  discount             Float?
  billingAddressId     String?
  shippingAddressId    String?

  documents       Document[]
  items           OrderItem[]
  buyer           User?       @relation(fields: [buyerId], references: [id])
  billingAddress  Address?    @relation("BillingAddress", fields: [billingAddressId], references: [id])
  shippingAddress Address?    @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
}

/// Ítems dentro de una orden (referencian `CatalogItem`).
model OrderItem {
  id             String          @id @default(uuid())
  orderId        String
  itemId         Int
  quantity       Int
  unitPrice      Float
  totalPrice     Float
  status         OrderItemStatus @default(PENDING)
  isBestSeller   Boolean         @default(false)
  isGift         Boolean         @default(false)
  isNew          Boolean         @default(false)
  qtyDone        Int?
  // Descuento aplicado al ítem
  discountId     Int?
  discountAmount Float?
  order          PurchaseOrder   @relation(fields: [orderId], references: [id])
  item           CatalogItem     @relation(fields: [itemId], references: [id])
  discount       Discount?       @relation(fields: [discountId], references: [id])
}

/// Documentos adjuntos a órdenes (facturas, recibos, guías, etc.).
model Document {
  id         String         @id @default(uuid())
  orderId    String
  type       DocumentType
  title      String
  url        String
  uploadedAt DateTime       @default(now())
  status     DocumentStatus @default(PENDING)
  hash       String
  mimeType   String
  size       Int

  order PurchaseOrder @relation(fields: [orderId], references: [id])
}

/// Gastos operativos con categorías, montos, aprobaciones y estado.
model Expense {
  id            String          @id @default(uuid())
  date          DateTime
  description   String
  amount        Float
  category      ExpenseCategory
  paymentMethod String
  receipt       String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  userId        String
  approvedBy    String?
  approvedAt    DateTime?
  state         Boolean         @default(true)
  subtotal      Float
  taxes         Float
}

/// Auditoría de acciones: entidad afectada, cambios, agente y contexto.
model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  userId     String
  changes    Json
  ipAddress  String
  userAgent  String
  timestamp  DateTime @default(now())
}

// (El modelo OAuthAccount ya está definido arriba; se elimina duplicado)

/// Banners promocionales con ventana de vigencia y estado.
model Banner {
  id        String       @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  dateInit  DateTime     @db.Timestamp(6)
  dateEnd   DateTime     @db.Timestamp(6)
  imageUrl  String
  status    BannerStatus
  createdAt DateTime     @default(now()) @db.Timestamp(6)
  updatedAt DateTime     @default(now()) @updatedAt @db.Timestamp(6)
}

/// Roles de usuario y permisos generales.
enum Role {
  USER
  ADMIN
  WAREHOUSE
  MANAGER
}

/// Tipos de descuento disponibles.
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
}

/// Estados del almacén.
enum WarehouseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

/// Estados del stock por ítem.
enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

/// Tipos de movimiento de stock.
enum MovementType {
  IN
  OUT
  TRANSFER
}

/// Estados de la orden.
enum OrderStatus {
  PENDING
  APPROVED
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Estados del ítem de la orden.
enum OrderItemStatus {
  PENDING
  COMPLETED
  UNCOMPLETED
}

/// Estados del pago.
enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

/// Tipos de documento.
enum DocumentType {
  INVOICE
  RECEIPT
  DELIVERY_NOTE
  OTHER
}

/// Estados del documento.
enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Estados del proveedor.
enum SupplierStatus {
  ACTIVE
  INACTIVE
}

/// Categorías de gasto.
enum ExpenseCategory {
  MATERIALS
  TOOLS
  MARKETING
  SALARIES
  RENT
  SERVICES
  OTHER
}

/// Estados del banner.
enum BannerStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}
